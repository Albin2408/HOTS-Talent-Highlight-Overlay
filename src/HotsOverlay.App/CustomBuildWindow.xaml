<Window x:Class="HotsOverlay.App.CustomBuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add your own build" Height="470" Width="460"
        Background="#1b1f27" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252b36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#3a4150"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#c7d3e0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2f6fa8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock x:Name="HeroText" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
            Paste the 7 talent names, one per line, for levels 1, 4, 7, 10, 13, 16 and 20 — copied
            from any build guide, or read off the in-game talent cards. Spell them as the game does;
            the overlay finds each card by its name.
        </TextBlock>

        <TextBlock Text="Build name" Margin="0,0,0,3"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,10"/>

        <TextBlock Text="Talents (one per line)" Margin="0,0,0,3"/>
        <TextBox x:Name="TalentsBox" Height="180" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>

        <TextBlock x:Name="ErrorText" Foreground="#ff7a6b" TextWrapping="Wrap" MinHeight="34"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Cancel" IsCancel="True" Background="#3a4150"/>
            <Button Content="Save build" IsDefault="False" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
