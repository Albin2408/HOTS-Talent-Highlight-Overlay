  <ItemGroup>
    <ProjectReference Include="..\HotsOverlay.Core\HotsOverlay.Core.csproj" />
    <ProjectReference Include="..\HotsOverlay.Scraper\HotsOverlay.Scraper.csproj" />
    <ProjectReference Include="..\HotsOverlay.Vision\HotsOverlay.Vision.csproj" />
  </ItemGroup>

</Project>
